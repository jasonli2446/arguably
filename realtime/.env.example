# Arguably Realtime SFU – Environment Variables

# Public IP address for WebRTC (MUST be your server's public IP in production)
ANNOUNCED_IP=YOUR_PUBLIC_IP

# HTTP + Socket.io port
LISTEN_PORT=3001

# Number of mediasoup workers (default: min(cpus, 4))
# MEDIASOUP_NUM_WORKERS=2

# RTC port range for media traffic
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# TURN server settings
# TURN server settings (MUST use public IP and strong credentials in production)
TURN_HOST=YOUR_PUBLIC_IP
TURN_PORT=3478
TURN_USERNAME=arguably
TURN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# CORS: comma-separated allowed origins (omit for wildcard in dev)
# ALLOWED_ORIGINS=https://your-app.vercel.app
